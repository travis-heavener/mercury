#!/usr/bin/env bash

#
# Updates artifacts.lock's dependency version and host architecture
#
# Usage (ex. update OpenSSL to v3.6.0):
#   ./update_artifact "openssl" "3.6.0"
#

# CD into libs directory
cd "$(dirname "$0")/../../"

lockfile="/tmp/libs.lock"
exec 200>"$lockfile"
flock -x 200
if [ ! -d "libs" ]; then
    mkdir libs
fi
flock -u 200

cd libs

lockfile="/tmp/artifacts_lock.lock"
exec 200>"$lockfile"
flock -x 200

entry="$1=$2"
if [[ "$1" != pugixml ]]; then
    entry+="@$(uname -m)"
fi

touch artifacts.lock || exit 1
if grep -q "^$1=" artifacts.lock; then
    sed -i "s/^$1=.*$/$entry/" artifacts.lock
else
    { echo "$entry"; cat artifacts.lock; } > temp && mv temp artifacts.lock
fi
